students = {}

def add_student():
    roll = int(input("Enter roll number: "))
    name = input("Enter student name: ")
    marks = int(input("Enter marks: "))
    students[roll] = {"name": name, "marks": marks}
    print("Student added successfully!\n")

def display_students():
    if not students:
        print("No students found.\n")
    else:
        print("\nStudent List:")
        for roll, data in students.items():
            print("Roll:", roll, "| Name:", data["name"], "| Marks:", data["marks"])
        print()

def average_marks():
    if not students:
        print("No students available.\n")
    else:
        total = sum(data["marks"] for data in students.values())
        avg = total / len(students)
        print("Average Marks:", avg, "\n")

def topper():
    if not students:
        print("No students available.\n")
    else:
        top = max(students.items(), key=lambda x: x[1]["marks"])
        print("Topper:", top[1]["name"], "with marks", top[1]["marks"], "\n")

while True:
    print("----- Student Management Menu -----")
    print("1. Add Student")
    print("2. Display Students")
    print("3. Average Marks")
    print("4. Find Topper")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        add_student()
    elif choice == "2":
        display_students()
    elif choice == "3":
        average_marks()
    elif choice == "4":
        topper()
    elif choice == "5":
        print("Thank you! Program ended.")
        break
    else:
        print("Invalid choice. Try again.\n")
