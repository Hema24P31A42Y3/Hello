# EV / Energy Load Forecasting using Linear Regression

import pandas as pd
import numpy as np
from sklearn.linear_model import LinearRegression
import matplotlib.pyplot as plt

# Sample time-series load data (Hour vs Load in kW)
data = {
    'Hour': np.arange(1, 25),
    'Load_kW': [120,115,110,108,105,130,160,180,200,220,240,250,
                260,255,245,230,210,200,190,180,170,160,150,140]
}

df = pd.DataFrame(data)

# Prepare data
X = df[['Hour']]
y = df['Load_kW']

# Train model
model = LinearRegression()
model.fit(X, y)

# Predict next 6 hours
future_hours = np.array([[25],[26],[27],[28],[29],[30]])
predicted_load = model.predict(future_hours)

# Output
print("Predicted Load for next hours:")
for h, l in zip(future_hours, predicted_load):
    print(f"Hour {h[0]}: {l:.2f} kW")

# Plot
plt.plot(df['Hour'], df['Load_kW'], label='Actual Load')
plt.plot(future_hours, predicted_load, 'r--', label='Predicted Load')
plt.xlabel('Hour')
plt.ylabel('Load (kW)')
plt.legend()
plt.show()
